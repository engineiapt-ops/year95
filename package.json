{
  "name": "year95",
  "private": true,
  "version": "0.1.0",
  "description": "YEAR95 — AI Financial Intelligence",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=9 <10"
  },
  "scripts": {
    "typecheck": "pnpm --filter @year95/contracts build && npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "arch": "dependency-cruiser --config .dependency-cruiser.cjs --ts-config tsconfig.base.json apps packages",
    "test": "vitest run",
    "test:unit": "vitest --project unit run",
    "test:contract": "vitest --project contract run",
    "test:integration": "vitest --project integration run",
    "test:e2e": "vitest --project e2e run",
    "build": "npm run build --workspaces --if-present",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check:migrations": "node tools/check-migrations.mjs",
    "verify:arch": "node scripts/verify-architecture.mjs",
    "db:baseline": "pnpm --filter @year95/contracts build && pnpm --filter @year95/persistence build && node tools/db-baseline.mjs",
    "test:component": "vitest --project component run"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "2.1.8",
    "dependency-cruiser": "18.4.0"
  }
}
