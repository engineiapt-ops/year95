# Browser-public values only (VITE_*)
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Deterministic decision defaults
DECISION_MIN_CONFIDENCE=0.68
DECISION_MIN_PROBABILIDADE=0.62
DECISION_BLOQUEAR_RISCO_ELEVADO=true
FIXED_POSITION_PCT=1.5
