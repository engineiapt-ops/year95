# Server/runtime
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# PostgreSQL — backend only; /ready fails closed without a working database
DATABASE_URL=
# Optional PEM contents of the Supabase database root CA; see docs/DEPLOY-DB.md
DATABASE_CA_CERT_PEM=

# Public market data and optional Supabase Auth metadata
BINANCE_BASE_URL=https://api.binance.com
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_CLOCK_TOLERANCE_SECONDS=5

# Backend-only secrets
GEMINI_API_KEY=

# API policy limits
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_MAX=120
RATE_LIMIT_HEAVY_MAX=20

# Deterministic decision and sizing defaults
POSITION_NOTIONAL_BASE_PCT=1.5
RISK_PER_TRADE_PCT_DEFAULT=0.5
RISK_PER_TRADE_PCT_MAX=1

# Browser-public values only (VITE_*)
VITE_API_BASE_URL=http://localhost:3000
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
