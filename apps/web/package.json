{
  "name": "@year95/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "pnpm --filter @year95/config build && pnpm --filter @year95/contracts build && tsc -p tsconfig.json --noEmit",
    "build": "pnpm run typecheck && vite build && node scripts/check-bundle-secrets.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.57.4",
    "@year95/config": "workspace:*",
    "@year95/contracts": "workspace:*",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "6.30.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "jsdom": "25.0.1",
    "vite": "7.1.7"
  }
}
